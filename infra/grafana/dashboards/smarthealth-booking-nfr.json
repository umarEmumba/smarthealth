    {
      "id": 7,
      "type": "timeseries",
      "title": "NFR-02 gateway 5xx ratio",
      "description": "Share of gateway responses with a 5xx status. Threshold line: error_rate_max.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
