          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"smarthealth-gateway\",status=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"smarthealth-gateway\"}[5m])), 1e-9)",
