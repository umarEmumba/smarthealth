# Copy to infra/.env for Docker Compose. Never commit a real infra/.env file.
# Values here MUST match the root .env.example so app config and container
# wiring stay identical (see smarthealth/config.py).

# --- PostgreSQL (system of record) ---
POSTGRES_USER=smarthealth
POSTGRES_PASSWORD=changeme-local-dev-only
POSTGRES_DB=smarthealth

# --- MongoDB (audit trail / operational logs) ---
MONGO_DB_NAME=smarthealth

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- App-facing URLs, using Compose-internal service DNS names ---
DATABASE_URL=postgresql+asyncpg://smarthealth:changeme-local-dev-only@postgres:5432/smarthealth
MONGO_URL=mongodb://mongo:27017

# --- JWT / Auth ---
# Retired in Phase 1.1 (RS256 + JWKS; Identity's key is a Compose secret):
# JWT_SECRET and JWT_ALGORITHM are no longer read by any service.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OpenTelemetry / Jaeger (OTLP ingestion, internal compose network) ---
OTLP_ENDPOINT=http://jaeger:4317

# --- Kafka (KRaft mode, scaffolding only this phase — fixed base64 UUID) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=smarthealth
RABBITMQ_DEFAULT_PASS=changeme-local-dev-only

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=changeme-local-dev-only

# --- Host port overrides (optional) ---
# Every service's host-mapped port defaults to its conventional port
# (see docker-compose.yml). Override here if a port is already in use by
# another local process/container — internal Compose-network wiring (service
# DNS names) is unaffected by these overrides.
# POSTGRES_HOST_PORT=5433
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_UI_HOST_PORT=15672
# KAFKA_HOST_PORT=9092
# SCHEMA_REGISTRY_HOST_PORT=8081
# TEMPORAL_HOST_PORT=7233
# TEMPORAL_UI_HOST_PORT=8080
# JAEGER_UI_HOST_PORT=16686
# JAEGER_OTLP_GRPC_HOST_PORT=4317
# JAEGER_OTLP_HTTP_HOST_PORT=4318
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3000
# API_HOST_PORT=8000

# --- Phase 2 service databases (db-init creates the roles; placeholders only) ---
# IDENTITY/ORGANIZATION/PROVIDER/PATIENT/SCHEDULING_DB_PASSWORD follow the same pattern.
VISIT_DB_PASSWORD=changeme-visit-local-dev-only
BILLING_DB_PASSWORD=changeme-billing-local-dev-only

# --- Phase 2 behaviour knobs ---
# Simulated billing pre-check: a coverage_ref starting with this prefix is denied (D-10).
BILLING_PRECHECK_FAIL_PREFIX=DENY-
SCHEDULING_HOLD_TTL_MINUTES=10
SCHEDULING_CANCEL_CUTOFF_HOURS=24
# Containers always reach Temporal at temporal:7233 (set in docker-compose.yml);
# this value is for host-side tools only.
TEMPORAL_ADDRESS=localhost:7233

# --- Gateway rate limit ---
# Default 300 requests/minute per client. The concurrency demo needs a higher
# limit for its run only (Pitfall 10):
#   GATEWAY_RATE_LIMIT_DEFAULT_PER_MINUTE=100000 docker compose up -d gateway
# GATEWAY_RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- Service client secrets ---
# Never put values here. Run `python scripts/generate_service_secrets.py`; the
# files in infra/secrets/service-clients/ are delivered as Compose secrets.
