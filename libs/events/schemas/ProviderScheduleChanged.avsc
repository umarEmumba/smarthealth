{
  "type": "record",
  "name": "ProviderScheduleChanged",
  "namespace": "com.smarthealth.events",
  "doc": "A provider's schedule changed (D-07): an availability template was updated or deactivated, or the provider was deactivated. Published for consumers; Scheduling does not act on it in Phase 3. Ids, types and timestamps only (PHI-free).",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Deterministic uuid5 of aggregate_id:event_type:discriminator; the consumer idempotency key and the outbox primary key."},
    {"name": "event_type", "type": "string", "doc": "Always provider.schedule_changed for this record."},
    {"name": "schema_version", "type": "int", "doc": "Envelope/payload version stamped by the producer."},
    {"name": "occurred_at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "aggregate_id", "type": "string", "doc": "The provider id; also the Kafka message key."},
    {"name": "provider_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "change_event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "change_type", "type": "string", "doc": "The provider-service change kind: template_updated, template_deactivated or provider_deactivated."},
    {"name": "template_id", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null, "doc": "The availability template the change touched, when there is one."},
    {"name": "changed_at", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
