{
  "type": "record",
  "name": "VisitCompleted",
  "namespace": "com.smarthealth.events",
  "doc": "A visit was completed (D-07, D-10 revised: wait time is check-in to visit start, so both checked_in_at and started_at travel here). Ids, types and timestamps only: no clinical notes or diagnoses (PHI-free).",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Deterministic uuid5 of aggregate_id:event_type:discriminator; the consumer idempotency key and the outbox primary key."},
    {"name": "event_type", "type": "string", "doc": "Always visit.completed for this record."},
    {"name": "schema_version", "type": "int", "doc": "Envelope/payload version stamped by the producer."},
    {"name": "occurred_at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "aggregate_id", "type": "string", "doc": "The visit id; also the Kafka message key."},
    {"name": "visit_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "appointment_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "clinic_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "patient_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "provider_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "checked_in_at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "started_at", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "Null for a visit completed without a recorded start (backfilled or skipped-start visits)."},
    {"name": "completed_at", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
