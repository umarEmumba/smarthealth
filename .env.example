# Copy to .env and fill in local-dev values. Never commit a real .env file.

# --- Deployment environment ("development" | "test" | "staging" | "production") ---
# Identity refuses to start without its RS256 private key in any environment
# (JWT_PRIVATE_KEY_PATH; generate with scripts/generate_jwt_keypair.py).
ENVIRONMENT=development

# --- PostgreSQL (system of record) ---
POSTGRES_USER=smarthealth
POSTGRES_PASSWORD=changeme-local-dev-only
POSTGRES_DB=smarthealth
DATABASE_URL=postgresql+asyncpg://smarthealth:changeme-local-dev-only@localhost:5432/smarthealth

# --- MongoDB (audit trail / operational logs) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=smarthealth

# --- Redis (cache / locks / denylist / rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / Auth ---
# Retired in Phase 1.1 (RS256 + JWKS; Identity's key is a Compose secret):
# JWT_SECRET and JWT_ALGORITHM are no longer read by any service.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OpenTelemetry / Jaeger (OTLP ingestion) ---
OTLP_ENDPOINT=http://localhost:4317

# --- Kafka (KRaft mode, scaffolding only this phase) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Service-token client credentials (plan 02-01, D-06) ---
# Paths only — never put a secret value in an env var or in this file.
# Generate the files with: python scripts/generate_service_secrets.py
# Identity reads every <service>.secret in this directory for POST /internal/service-tokens:
SERVICE_CLIENT_SECRETS_DIR=infra/secrets/service-clients
# Each calling service reads only its own secret file:
SCHEDULING_CLIENT_SECRET_PATH=infra/secrets/service-clients/scheduling.secret
VISIT_CLIENT_SECRET_PATH=infra/secrets/service-clients/visit.secret
BILLING_CLIENT_SECRET_PATH=infra/secrets/service-clients/billing.secret

# --- Phase 2: Temporal, Scheduling, Visit, Billing (plan 02-12) ---
# Temporal frontend (host-side runs; the containers use temporal:7233).
TEMPORAL_ADDRESS=localhost:7233
# Per-service database URLs for host-side runs (placeholders; see infra/.env.example).
VISIT_DATABASE_URL=postgresql+asyncpg://visit_svc:changeme-visit-local-dev-only@localhost:5433/visit_db
BILLING_DATABASE_URL=postgresql+asyncpg://billing_svc:changeme-billing-local-dev-only@localhost:5433/billing_db
# Simulated billing pre-check: a coverage_ref starting with this prefix is denied (D-10).
BILLING_PRECHECK_FAIL_PREFIX=DENY-
# Booking hold lifetime and the refund cutoff for cancellations.
SCHEDULING_HOLD_TTL_MINUTES=10
SCHEDULING_CANCEL_CUTOFF_HOURS=24
# The concurrency demo (scripts/demo_concurrent_booking.py) fires many requests
# from one client; raise the gateway limit for THAT run only, e.g.
#   GATEWAY_RATE_LIMIT_DEFAULT_PER_MINUTE=100000 docker compose -f infra/docker-compose.yml up -d gateway
# GATEWAY_RATE_LIMIT_DEFAULT_PER_MINUTE=300
