# Copy to .env and fill in local-dev values. Never commit a real .env file.

# --- Deployment environment ("development" | "test" | "staging" | "production") ---
# CR-03: anything other than "development" REQUIRES a real JWT_SECRET below —
# the app refuses to start otherwise (fail-closed, see smarthealth/config.py).
ENVIRONMENT=development

# --- PostgreSQL (system of record) ---
POSTGRES_USER=smarthealth
POSTGRES_PASSWORD=changeme-local-dev-only
POSTGRES_DB=smarthealth
DATABASE_URL=postgresql+asyncpg://smarthealth:changeme-local-dev-only@localhost:5432/smarthealth

# --- MongoDB (audit trail / operational logs) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=smarthealth

# --- Redis (cache / locks / denylist / rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / Auth ---
JWT_SECRET=changeme-local-dev-only-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OpenTelemetry / Jaeger (OTLP ingestion) ---
OTLP_ENDPOINT=http://localhost:4317

# --- Kafka (KRaft mode, scaffolding only this phase) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Service-token client credentials (plan 02-01, D-06) ---
# Paths only — never put a secret value in an env var or in this file.
# Generate the files with: python scripts/generate_service_secrets.py
# Identity reads every <service>.secret in this directory for POST /internal/service-tokens:
SERVICE_CLIENT_SECRETS_DIR=infra/secrets/service-clients
# Each calling service reads only its own secret file:
SCHEDULING_CLIENT_SECRET_PATH=infra/secrets/service-clients/scheduling.secret
VISIT_CLIENT_SECRET_PATH=infra/secrets/service-clients/visit.secret
BILLING_CLIENT_SECRET_PATH=infra/secrets/service-clients/billing.secret
